# Fuel Tracker settings. Copy to .env and adjust.
# More settings (LubeLogger, mail, ...) are added as the features arrive;
# see docs/technical-design.md#settings.

# Time zone, used to read the dates on Pace receipts
TZ=Europe/Berlin

# IP address(es) of the reverse proxy, so the app sees the real client IP and
# HTTPS scheme from its X-Forwarded-* headers. Comma-separated, or * to trust all.
FORWARDED_ALLOW_IPS=127.0.0.1

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
