# Fuel Tracker settings. Copy to .env and adjust.
# More settings (LubeLogger, mail, ...) are added as the features arrive;
# see docs/technical-design.md#settings.

# Time zone, used to read the dates on Pace receipts
TZ=Europe/Berlin

# IP address(es) of the reverse proxy, so the app sees the real client IP and
# HTTPS scheme from its X-Forwarded-* headers. Comma-separated, or * to trust all.
FORWARDED_ALLOW_IPS=127.0.0.1

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- Notifications by email ---
# Every notification is also sent by email, if the user wants that kind: to the user it is
# about, or to the admins if the user has no address and for anything not about one user.
# Each user sets their own address and choices on the Account page.
# An Apprise email URL with the login of your mail server. Write special characters in the password as %XX (@ is %40). Use
# mailtos:// for an encrypted connection (STARTTLS by default, mode=ssl for port 465) and
# mailto://...?mode=insecure for none. Leave empty to send no emails.
# APPRISE_EMAIL_URL=mailtos://fuel%40example.org:password@smtp.example.org:587?from=fuel@example.org&name=Fuel%20Tracker
# The address you open Fuel Tracker at. Each email links to the page it is about. Empty: no link.
# PUBLIC_URL=https://fuel.example.org

# --- Updates ---
# Look daily whether a newer Fuel Tracker image exists (shown on the settings page).
# A release image only looks for newer releases, a test image for a newer test image.
UPDATE_CHECK=true
UPDATE_CHECK_IMAGE=ghcr.io/pidi3000/fuel_tracker

# --- LubeLogger ---
LUBELOGGER_URL=http://lubelogger:8080
# An API key with Edit permission, if LubeLogger requires login
LUBELOGGER_API_KEY=
# Names of the extra fields you created for fuel records in LubeLogger
LUBELOGGER_FIELD_GPS=GPS Location
LUBELOGGER_FIELD_ADDRESS=Address

# --- Mailbox that receives the Pace Drive receipts (IMAP) ---
# Leave IMAP_HOST empty to run without email receipts (manual fuel-ups only)
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_INBOX=INBOX
# Receipts that were used or ignored are moved here (created if missing)
IMAP_PROCESSED_FOLDER=Processed
# Emails count as receipts if they come from this address and the subject
# matches this regular expression. Several addresses can be given, separated by
# commas (e.g. while testing with an old account):
# RECEIPT_SENDER=no-reply@connectedfueling.com,old.account@example.org
RECEIPT_SENDER=no-reply@connectedfueling.com
RECEIPT_SUBJECT_PATTERN=\|\s*PACE Pay\s*$

# --- Fuel-ups ---
# Hold every fuel-up for your approval before it is sent to LubeLogger
REVIEW_BEFORE_SEND=true
FUEL_TYPES=Diesel,Super,Super Plus,Super E10
VOLUME_UNIT=L
CURRENCY=EUR

# A receipt matches a fuel-up when their times are at most this many minutes apart
MATCH_WINDOW_MINUTES=10
# A fuel-up that waited this many minutes for its receipt fails
RECEIPT_TIMEOUT_MINUTES=60
# Date format of the receipts (the English Pace Drive app)
PACE_DATE_FORMAT=%m/%d/%Y, %I:%M %p
